{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["typescript", "unicorn", "import"],
  "jsPlugins": ["eslint-plugin-no-relative-import-paths"],
  "env": {
    "builtin": true,
    "es2018": true,
    "node": true
  },
  "ignorePatterns": [
    "**/out/*",
    "**/forever-ignore/*",
    "morgues/*",
    "logfiles/*",
    ".yarn",
    "crawl/**/*"
  ],
  "rules": {
    "unicorn/no-single-promise-in-promise-methods": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-restricted-properties": [
      "error",
      {
        "object": "Type",
        "property": "Ref",
        "message": "Use schemaRef(schema) from ~/app/schemas/ref to preserve response type inference."
      },
      {
        "object": "Type",
        "property": "Unsafe",
        "message": "Type.Unsafe is reserved for schemaRef. Use concrete TypeBox schemas elsewhere."
      }
    ],
    "no-relative-import-paths/no-relative-import-paths": [
      "warn",
      { "allowSameFolder": true, "rootDir": "src", "prefix": "~" }
    ]
  }
}
