{
  "name": "@dcss-stats/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn type-check && vite build",
    "package": "yarn build && cd dist && zip -FSr ../extension.zip .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "oxlint",
    "test": "yarn lint && yarn type-check"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,tsx}": [
      "oxlint --deny-warnings --fix"
    ]
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
