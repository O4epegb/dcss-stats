{
  "$schema": "node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": [".oxlintrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "test": {
      "dependsOn": ["lint", "type-check"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^type-check", "typegen"]
    },
    "typegen": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "bootstrap": {
      "cache": false
    }
  }
}
